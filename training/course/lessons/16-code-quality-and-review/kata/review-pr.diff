diff --git a/dashboard/src/features/bookings/bookings-slice.ts b/dashboard/src/features/bookings/bookings-slice.ts
new file mode 100644
index 0000000..75ab0bd
--- /dev/null
+++ b/dashboard/src/features/bookings/bookings-slice.ts
@@ -0,0 +1,16 @@
+import { createSlice, type PayloadAction } from '@reduxjs/toolkit';
+
+import type { BookingDto } from './types';
+
+const bookingsSlice = createSlice({
+  name: 'bookings',
+  initialState: { items: [] as BookingDto[] },
+  reducers: {
+    setBookings: (state, action: PayloadAction<BookingDto[]>) => {
+      state.items = action.payload;
+    },
+  },
+});
+
+export const { setBookings } = bookingsSlice.actions;
+export const bookingsReducer = bookingsSlice.reducer;
diff --git a/dashboard/src/features/bookings/components/RevenueCard.tsx b/dashboard/src/features/bookings/components/RevenueCard.tsx
new file mode 100644
index 0000000..9f63716
--- /dev/null
+++ b/dashboard/src/features/bookings/components/RevenueCard.tsx
@@ -0,0 +1,33 @@
+import { Card, Select, Text } from '@mantine/core';
+import { useQuery } from '@tanstack/react-query';
+import { useEffect, useState } from 'react';
+
+import { useAppDispatch } from '../../../app/hooks';
+import { listBookings } from '../api/bookings-api';
+import { setBookings } from '../bookings-slice';
+import type { BookingStatus } from '../types';
+
+export default function RevenueCard() {
+  const dispatch = useAppDispatch();
+  const [status, setStatus] = useState<BookingStatus | ''>('');
+  const { data } = useQuery({
+    queryKey: ['bookings'],
+    queryFn: () => listBookings({ status, pageSize: 500 }),
+    refetchInterval: 5000,
+  });
+
+  useEffect(() => {
+    if (data) dispatch(setBookings(data.items));
+  }, [data, dispatch]);
+
+  const revenue = (data?.items ?? []).reduce((sum, b) => sum + b.totalCents, 0);
+
+  return (
+    <Card padding={18} style={{ background: '#0B1F14' }}>
+      <Select data={['', 'CONFIRMED', 'CANCELLED']} value={status} onChange={(v) => setStatus((v ?? '') as BookingStatus)} />
+      <Text c="#C6F432" fz={32} fw={800}>
+        GH₵ {(revenue / 100).toFixed(2)}
+      </Text>
+    </Card>
+  );
+}
