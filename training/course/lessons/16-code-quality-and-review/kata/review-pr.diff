diff --git a/mobile/components/BookAgainButton.tsx b/mobile/components/BookAgainButton.tsx
new file mode 100644
index 0000000..c9debae
--- /dev/null
+++ b/mobile/components/BookAgainButton.tsx
@@ -0,0 +1,40 @@
+import { useState } from 'react';
+import { Alert, Pressable, Text } from 'react-native';
+
+import { bookingsApi } from '@/api/bookings-api';
+import type { Booking } from '@/api/types';
+
+export default function BookAgainButton({ booking }: { booking: Booking }) {
+  const [loading, setLoading] = useState(false);
+
+  const click = async () => {
+    setLoading(true);
+    const segment = booking.segments[0];
+    const total = segment.unitFareCents * booking.passengers.length + 250;
+    try {
+      await bookingsApi.create({
+        tripType: 'ONE_WAY',
+        segments: [
+          {
+            journeyId: segment.journey.id,
+            travelClass: segment.travelClass,
+            direction: 'OUTBOUND',
+            seats: segment.tickets.map((t) => ({ carNumber: t.carNumber, seatNumber: t.seatNumber })),
+          },
+        ],
+        addOns: [],
+        totalCents: total,
+      } as any);
+      Alert.alert('Booked!', `You paid GH₵ ${(total / 100).toFixed(2)}`);
+    } catch (e) {
+      console.log(e);
+    }
+    setLoading(false);
+  };
+
+  return (
+    <Pressable onPress={click} style={{ backgroundColor: '#C6F432', padding: 14, borderRadius: 22, marginTop: 6 }}>
+      <Text style={{ fontWeight: '700', fontSize: 15 }}>{loading ? '...' : 'Book again'}</Text>
+    </Pressable>
+  );
+}
