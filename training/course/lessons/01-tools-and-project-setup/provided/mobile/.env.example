# RailPass mobile API endpoint.
# Local simulator default: http://localhost:3000/api
# Physical phones need the facilitator LAN URL, for example:
# EXPO_PUBLIC_API_URL=http://<facilitator-ip>:3000/api
# Android emulator can use http://10.0.2.2:3000/api
# iOS simulator can use localhost.
EXPO_PUBLIC_API_URL=http://localhost:3000/api
