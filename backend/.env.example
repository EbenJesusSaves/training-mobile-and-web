# Copy to .env and adjust. Never commit real secrets.
PORT=3000
# Matches docker-compose.yml (host port 5433 -> container 5432)
DATABASE_URL=postgresql://railpass:railpass_dev_password@localhost:5433/railpass?schema=public
# Used by `yarn test:e2e`; the database is created/migrated automatically by the test script.
TEST_DATABASE_URL=postgresql://railpass:railpass_dev_password@localhost:5433/railpass_test?schema=public
# Generate a long random value for anything beyond local development: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated list of browser origins allowed to call the API (dashboard dev server).
CORS_ORIGINS=http://localhost:5173
# Development email delivery goes to Mailpit (docker compose). Inbox: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="RailPass <no-reply@railpass.dev>"
# Development only: also print password-reset codes in the API log.
LOG_RESET_CODES=true
